# Agentic Problem Solver - Environment Configuration Template

# Google Gemini API
GEMINI_API_KEY=your-api-key-here
LLM_MODEL=gemini-1.5-flash

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./data/user/logs

# Problem Solver Configuration
MAX_SOLVE_STEPS=5
SOLVE_TIMEOUT=300
SAVE_INTERMEDIATE_RESULTS=true

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000
